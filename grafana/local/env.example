# Address of the remote htcondordb. Discover it from the pool's collector:
#
#   condor_status -pool cm-1.ospool.osg-htc.org -any \
#       -constraint 'MyType=="HTCondorDB"' -af Name MyAddress
#
# Add ?alias=<hostname> if you want SSL auth to validate the server's certificate
# (a bare IP has no SAN to match).
HTCONDORDB_ADDR=<128.105.68.62:9618?alias=ap40.uw.osg-htc.org&sock=htcondordb_9188_c841>

# An IDTOKEN issued by the SAME trust domain as the server. On the AP:
#   condor_token_fetch -lifetime 86400
# A token from another issuer (e.g. a flock token) is silently ignored.
HTCONDORDB_TOKEN=
