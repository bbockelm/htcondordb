# Which database, named through its pool -- the plugin asks the collector on every
# connection, so this keeps working across an htcondordb restart. List a pool with:
#
#   condor_status -pool cm-1.ospool.osg-htc.org -any \
#       -constraint 'MyType=="HTCondorDB"' -af Name MyAddress
#
HTCONDORDB_POOL=cm-1.ospool.osg-htc.org
HTCONDORDB_NAME=htcondordb@ap40.uw.osg-htc.org

# An IDTOKEN issued by the SAME trust domain as the server. On the AP:
#   condor_token_fetch -lifetime 86400
# A token from another issuer (e.g. a flock token) is silently ignored.
HTCONDORDB_TOKEN=
